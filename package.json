{
  "name": "fragrance-app",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @fragrance/web",
    "dev:mobile": "npm run start --workspace @fragrance/mobile",
    "build:web": "npm run build --workspace @fragrance/web",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  }
}
