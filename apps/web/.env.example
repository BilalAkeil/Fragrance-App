# Copy to .env.local. Find both in Supabase: Project Settings > API.
# Leave empty to run on sample data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only: never in a NEXT_PUBLIC_ variable, never committed. Same page in
# Supabase. Used by scripts/dev-sign-in.ts and scripts/import-catalogue.ts for now,
# and by server code from 003. Only ever the development project's key on our machines.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe, test mode only (see docs/setup/stripe.md). Developers > API keys.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Server only: never in a NEXT_PUBLIC_ variable, never committed or pasted into chat.
STRIPE_SECRET_KEY=
# Printed by `stripe listen --forward-to localhost:3000/api/webhooks/stripe`. Each of us has our own.
STRIPE_WEBHOOK_SECRET=

# Stripe, test mode (docs/setup/stripe.md). The secret key and webhook secret are server only.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Printed by `stripe listen --forward-to localhost:3000/api/webhooks/stripe`.
STRIPE_WEBHOOK_SECRET=

# The site's own address, for links Stripe sends people back to.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shipping provider (004). Only "fake" exists until the broker is chosen.
SHIPPING_PROVIDER=fake

# Protects /api/cron/tick. Any long random string; Vercel Cron sends it.
CRON_SECRET=
