# Copy to .env.local. Find both in Supabase: Project Settings > API.
# Leave empty to run on sample data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only: never in a NEXT_PUBLIC_ variable, never committed. Same page in
# Supabase. Used by scripts/dev-sign-in.ts and scripts/import-catalogue.ts for now,
# and by server code from 003. Only ever the development project's key on our machines.
SUPABASE_SERVICE_ROLE_KEY=
